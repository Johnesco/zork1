# Zork I: Inform 7 Edition — RegTest regression tests
# Run with: wsl -e bash tests/run-tests.sh
#
# Format reference: https://eblong.com/zarf/plotex/regtest.html
#   >command          send a command
#   /regex            output must match regex (NO trailing slash)
#   literal text      output must contain literal string
#   !text             output must NOT contain this text
#   {vital}           abort test on failure
#   >{include}name    include commands from another test
#
# NOTE: Troll combat is random (~70% hit rate). Tests that go through
# the troll may occasionally fail due to bad RNG rolls. Re-run if so.


# ============================================================
# Basic smoke tests
# ============================================================

